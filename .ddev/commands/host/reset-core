#!/bin/bash

## Description: Reset Drupal core to a clean install with recipes for testing patches
## Usage: reset-core [patch-file]
## Example: ddev reset-core
## Example: ddev reset-core my-fix.patch
## ProjectTypes: drupal12

set -euo pipefail

PATCH_FILE="${1:-}"
PROJECT_DIR="$(dirname "$0")/../../.."
cd "$PROJECT_DIR"

echo "=== Drupal Core Reset ==="
echo ""

# 1. Git clean — reset to HEAD, remove untracked files (preserve key dirs)
echo "[1/6] Cleaning git working tree..."
git checkout -- .
git clean -fd --exclude=.ddev --exclude=test-results --exclude='*.patch' --exclude='*.md' --exclude=953034-patches --exclude=.playwright-mcp --exclude=.gc-src

# 2. Composer install
echo "[2/6] Running composer install..."
ddev exec composer install --no-interaction --quiet

# 3. Ensure ddev is running
echo "[3/6] Ensuring ddev is running..."
ddev start

# 4. Install Drupal with recipes
echo "[4/6] Installing Drupal with recipes..."
ddev exec drush site:install standard \
  --account-name=admin \
  --account-pass=admin \
  -y

# 5. Enable additional recipes not included by standard
echo "[5/6] Enabling additional recipes for test coverage..."
ddev exec "drush recipe core/recipes/editorial_workflow"
ddev exec "drush recipe core/recipes/comment_base"
ddev exec "drush recipe core/recipes/image_media_type"
ddev exec "drush recipe core/recipes/tags_taxonomy"

# 6. Finalize
echo "[6/6] Rebuilding cache and verifying..."
ddev exec drush cache:rebuild
ddev exec drush status --fields=drupal-version,site,db-driver,php

echo ""
SITE_URL=$(ddev describe 2>/dev/null | grep -m1 'https://' | awk '{print $NF}' || echo "https://drupal-core.ddev.site")
echo "=== Site ready at ${SITE_URL} ==="
echo "  User: admin / Pass: admin"
echo ""

# 7. Apply patch if provided
if [ -n "$PATCH_FILE" ]; then
  if [ -f "$PATCH_FILE" ]; then
    echo "[patch] Applying $PATCH_FILE..."
    git apply "$PATCH_FILE"
    ddev exec composer install --no-interaction --quiet
    echo "[patch] Done. Patch applied on top of clean install."
  else
    echo "[patch] WARNING: File '$PATCH_FILE' not found. Skipping."
  fi
fi
