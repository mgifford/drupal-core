{#
/**
 * @file
 * Default theme implementation for a form element label.
 *
 * Available variables:
 * - title: The label's text.
 * - title_display: Elements title_display setting.
 * - required: An indicator for whether the associated form element is required.
 * - attributes: A list of HTML attributes for the title element.
 * - labelable: Whether the title labels a labelable form control. If false, the
 *   title is rendered in a span instead of a label.
 *
 * @see \Drupal\Core\Form\FormPreprocess::preprocessFormElementLabel()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    title_display == 'after' ? 'option',
    title_display == 'invisible' ? 'visually-hidden',
    required ? 'js-form-required',
    required ? 'form-required',
  ]
%}
{% if title is not empty or required -%}
  {%- if labelable -%}
    <label{{ attributes.addClass(classes) }}>{{ title }}</label>
  {%- else -%}
    <span{{ attributes.addClass(classes) }}>{{ title }}</span>
  {%- endif -%}
{%- endif %}
